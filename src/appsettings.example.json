{
  "MssqlMcpServer": {
    "DefaultProfile": "local-dev",
    "Profiles": {
      "local-dev": {
        "ConnectionString": "Server=localhost,1433;Database=app_db_dev;User Id=sa;Password=YourStrong@Passw0rd!;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=Optional;",
        "DefaultDatabase": "app_db_dev",
        "AllowedDatabases": [ "app_db_*", "test_*" ],
        "IsReadOnly": false,
        "AllowExecuteSp": true,
        "AllowSimulation": true,
        "Description": "Local development database instance with full simulation and execution rights."
      },
      "staging": {
        "ConnectionString": "Server=sql-staging.example.internal,1433;Database=app_db_staging;User Id=appuser;Password=YourStagingPassword!;TrustServerCertificate=True;Encrypt=Optional;",
        "DefaultDatabase": "app_db_staging",
        "AllowedDatabases": [ "app_db_staging" ],
        "IsReadOnly": false,
        "AllowExecuteSp": true,
        "AllowSimulation": true,
        "Description": "Staging server for staging integration testing."
      },
      "production-audit": {
        "ConnectionString": "Server=sql-prod.example.internal;Database=app_db_prod;User Id=auditor;Password=YourProdPassword!;TrustServerCertificate=False;Encrypt=True;",
        "DefaultDatabase": "app_db_prod",
        "AllowedDatabases": [ "app_db_prod" ],
        "IsReadOnly": true,
        "AllowExecuteSp": false,
        "AllowSimulation": false,
        "Description": "Production audit profile strictly locked in read-only mode."
      }
    },
    "Security": {
      "DeniedDatabases": [
        "master",
        "msdb",
        "tempdb",
        "model"
      ],
      "DeniedTables": [
        "*Password*",
        "*Token*",
        "*Secret*",
        "*Session*",
        "*Credential*"
      ],
      "DeniedColumns": [
        "*Password*",
        "*Token*",
        "*Secret*",
        "*Hash*",
        "*Salt*"
      ],
      "MaxRowsLimit": 500,
      "DefaultTimeoutSeconds": 30
    }
  }
}
